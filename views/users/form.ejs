<h2><i class="bi bi-person-plus-fill"></i> <%= title %></h2>
<a href="/users" class="btn btn-secondary mb-3"><i class="bi bi-arrow-left"></i> Back to Users</a>

<% if (errors.length > 0) { %>
  <div class="alert alert-danger">
    <ul class="mb-0"><% errors.forEach(e => { %><li><%= e.msg %></li><% }); %></ul>
  </div>
<% } %>

<form method="POST" action="/users/create" id="userForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label">Full Name *</label>
      <input type="text" name="FullName" class="form-control" value="<%= targetUser.FullName || '' %>" required
        data-validate="required,maxlength:100" data-label="Full Name" maxlength="100">
      <div class="validation-error" id="FullName-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Email *</label>
      <input type="email" name="Email" class="form-control" value="<%= targetUser.Email || '' %>" required
        data-validate="required,email" data-label="Email">
      <div class="validation-error" id="Email-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Password *</label>
      <input type="password" name="Password" class="form-control" required
        data-validate="required,password" data-label="Password">
      <div class="form-text">Min 8 chars, 1 uppercase, 1 lowercase, 1 number.</div>
      <div class="validation-error" id="Password-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Role *</label>
      <select name="RoleId" class="form-select" required>
        <option value="">-- Select Role --</option>
        <% roles.forEach(r => { %>
          <option value="<%= r.RoleId %>" <%= String(targetUser.RoleId)===String(r.RoleId)?'selected':'' %>><%= r.RoleName %></option>
        <% }); %>
      </select>
    </div>
  </div>
  <button class="btn btn-success"><i class="bi bi-check-lg"></i> Create User</button>
</form>
<script>document.addEventListener('DOMContentLoaded', function(){ validateForm('userForm'); });</script>
