<h2><i class="bi bi-funnel"></i> <%= title %></h2>
<a href="/leads" class="btn btn-secondary mb-3"><i class="bi bi-arrow-left"></i> Back</a>

<% if (errors.length > 0) { %>
  <div class="alert alert-danger">
    <ul class="mb-0"><% errors.forEach(e => { %><li><%= e.msg %></li><% }); %></ul>
  </div>
<% } %>

<form method="POST" action="/leads/<%= isEdit ? 'edit/' + lead.LeadId : 'create' %>" id="leadForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label">Lead Name *</label>
      <input type="text" name="LeadName" class="form-control" value="<%= lead.LeadName || '' %>" required
        data-validate="required,maxlength:100" data-label="Lead Name" maxlength="100">
      <div class="validation-error" id="LeadName-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Email *</label>
      <input type="email" name="Email" class="form-control" value="<%= lead.Email || '' %>" required
        data-validate="required,email" data-label="Email">
      <div class="validation-error" id="Email-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Phone *</label>
      <input type="text" name="Phone" class="form-control" value="<%= lead.Phone || '' %>" required
        data-validate="required,phone" data-label="Phone" maxlength="10">
      <div class="validation-error" id="Phone-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Company Name</label>
      <input type="text" name="CompanyName" class="form-control" value="<%= lead.CompanyName || '' %>" maxlength="100">
    </div>
    <div class="col-md-4 mb-3">
      <label class="form-label">Source *</label>
      <select name="Source" class="form-select" required>
        <% ['Website','Referral','Cold Call','Email Campaign','Social Media','Other'].forEach(s => { %>
          <option value="<%= s %>" <%= (lead.Source||'Website')===s?'selected':'' %>><%= s %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-md-4 mb-3">
      <label class="form-label">Status *</label>
      <% if (isEdit) { %>
        <select name="Status" class="form-select">
          <option value="<%= typeof currentStatus !== 'undefined' ? currentStatus : 'New' %>" selected><%= typeof currentStatus !== 'undefined' ? currentStatus : 'New' %> (current)</option>
          <% if (typeof allowedStatuses !== 'undefined') { allowedStatuses.forEach(s => { %>
            <option value="<%= s %>"><%= s %></option>
          <% }); } %>
        </select>
      <% } else { %>
        <select name="Status" class="form-select">
          <option value="New" selected>New</option>
        </select>
      <% } %>
    </div>
    <div class="col-md-4 mb-3">
      <label class="form-label">Priority</label>
      <select name="Priority" class="form-select">
        <% ['Low','Medium','High'].forEach(p => { %>
          <option value="<%= p %>" <%= (lead.Priority||'Medium')===p?'selected':'' %>><%= p %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-md-4 mb-3">
      <label class="form-label">Expected Value</label>
      <input type="number" name="ExpectedValue" class="form-control" value="<%= lead.ExpectedValue || '' %>" min="0" step="0.01">
    </div>
    <div class="col-md-4 mb-3">
      <label class="form-label">Assigned To *</label>
      <select name="AssignedTo" class="form-select" required>
        <option value="">-- Select --</option>
        <% users.forEach(u => { %>
          <option value="<%= u.UserId %>" <%= String(lead.AssignedTo)===String(u.UserId)?'selected':'' %>><%= u.FullName %></option>
        <% }); %>
      </select>
      <div class="validation-error" id="AssignedTo-error"></div>
    </div>
    <div class="col-12 mb-3">
      <label class="form-label">Notes</label>
      <textarea name="Notes" class="form-control" rows="3"><%= lead.Notes || '' %></textarea>
    </div>
  </div>
  <button class="btn btn-success"><i class="bi bi-check-lg"></i> Save</button>
</form>
<script>document.addEventListener('DOMContentLoaded', function(){ validateForm('leadForm'); });</script>
