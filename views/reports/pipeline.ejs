<h2><i class="bi bi-bar-chart"></i> Pipeline Report</h2>
<p class="text-muted">Stage-wise and Owner-wise open opportunities breakdown with weighted pipeline amounts.</p>
<hr>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white">
        <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Open Pipeline by Stage</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped mb-0">
            <thead class="table-light">
              <tr>
                <th>Stage</th>
                <th class="text-center">Count</th>
                <th class="text-end">Total Amount</th>
                <th class="text-end">Weighted Amount</th>
              </tr>
            </thead>
            <tbody>
              <% if (byStage.length === 0) { %>
                <tr><td colspan="4" class="text-center text-muted">No open opportunities.</td></tr>
              <% } %>
              <% byStage.forEach(s => { %>
                <tr>
                  <td><span class="badge bg-primary"><%= s.Stage %></span></td>
                  <td class="text-center"><%= s.count %></td>
                  <td class="text-end">$<%= Number(s.totalAmount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                  <td class="text-end">$<%= Number(s.weightedAmount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white">
        <h5 class="mb-0"><i class="bi bi-person-check"></i> Open Pipeline by Owner</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped mb-0">
            <thead class="table-light">
              <tr>
                <th>Owner</th>
                <th class="text-center">Count</th>
                <th class="text-end">Total Amount</th>
                <th class="text-end">Weighted Amount</th>
              </tr>
            </thead>
            <tbody>
              <% if (byOwner.length === 0) { %>
                <tr><td colspan="4" class="text-center text-muted">No open opportunities.</td></tr>
              <% } %>
              <% byOwner.forEach(o => { %>
                <tr>
                  <td><strong><%= o.owner %></strong></td>
                  <td class="text-center"><%= o.count %></td>
                  <td class="text-end">$<%= Number(o.totalAmount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                  <td class="text-end">$<%= Number(o.weightedAmount).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
