<h2><i class="bi bi-person-plus"></i> <%= title %></h2>
<a href="/customers" class="btn btn-secondary mb-3"><i class="bi bi-arrow-left"></i> Back</a>

<% if (errors.length > 0) { %>
  <div class="alert alert-danger">
    <ul class="mb-0"><% errors.forEach(e => { %><li><%= e.msg %></li><% }); %></ul>
  </div>
<% } %>

<form method="POST" action="/customers/<%= customer.CustomerId ? 'edit/' + customer.CustomerId : 'create' %>" id="customerForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label">Customer Name *</label>
      <input type="text" name="CustomerName" class="form-control" value="<%= customer.CustomerName || '' %>" required
        data-validate="required,maxlength:100" data-label="Customer Name" maxlength="100">
      <div class="validation-error" id="CustomerName-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Email *</label>
      <input type="email" name="Email" class="form-control" value="<%= customer.Email || '' %>" required
        data-validate="required,email" data-label="Email">
      <div class="validation-error" id="Email-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Phone *</label>
      <input type="text" name="Phone" class="form-control" value="<%= customer.Phone || '' %>" required
        data-validate="required,phone" data-label="Phone" maxlength="10">
      <div class="validation-error" id="Phone-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Company Name</label>
      <input type="text" name="CompanyName" class="form-control" value="<%= customer.CompanyName || '' %>"
        data-validate="maxlength:100" data-label="Company Name" maxlength="100">
      <div class="validation-error" id="CompanyName-error"></div>
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Address</label>
      <input type="text" name="Address" class="form-control" value="<%= customer.Address || '' %>"
        maxlength="200">
    </div>
    <div class="col-md-3 mb-3">
      <label class="form-label">City</label>
      <input type="text" name="City" class="form-control" value="<%= customer.City || '' %>" maxlength="50">
    </div>
    <div class="col-md-3 mb-3">
      <label class="form-label">State</label>
      <input type="text" name="State" class="form-control" value="<%= customer.State || '' %>" maxlength="50">
    </div>
    <% if (customer.CustomerId) { %>
    <div class="col-md-3 mb-3">
      <label class="form-label">Status</label>
      <select name="Status" class="form-select">
        <option value="Active" <%= customer.Status==='Active'?'selected':'' %>>Active</option>
        <option value="Inactive" <%= customer.Status==='Inactive'?'selected':'' %>>Inactive</option>
      </select>
    </div>
    <% } %>
  </div>
  <button class="btn btn-success"><i class="bi bi-check-lg"></i> Save</button>
</form>
<script>document.addEventListener('DOMContentLoaded', function(){ validateForm('customerForm'); });</script>
