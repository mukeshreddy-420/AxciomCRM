<h2><i class="bi bi-calendar-check"></i> Follow-Ups</h2>
<a href="/followups/create" class="btn btn-primary mb-3"><i class="bi bi-plus-circle"></i> New Follow-Up</a>

<form class="row g-2 mb-3" method="GET" action="/followups">
  <div class="col-md-3">
    <input type="text" name="search" class="form-control" placeholder="Search subject, customer, lead..." value="<%= search %>">
  </div>
  <div class="col-md-2">
    <select name="status" class="form-select">
      <option value="">All Status</option>
      <% FOLLOWUP_STATUSES.forEach(s => { %>
        <option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-md-2">
    <button class="btn btn-outline-primary"><i class="bi bi-search"></i> Filter</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Date</th><th>Subject</th><th>Type</th><th>Customer</th><th>Lead</th><th>Status</th><th>Assigned</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (followups.length === 0) { %>
        <tr><td colspan="8" class="text-center text-muted">No follow-ups found.</td></tr>
      <% } %>
      <% followups.forEach(f => { %>
        <tr class="<%= f.Status === 'Missed' ? 'table-danger' : (f.Status === 'Completed' ? 'table-success' : '') %>">
          <td><%= f.FollowUpDate %></td>
          <td><%= f.Subject %></td>
          <td><%= f.FollowUpType %></td>
          <td><%= f.CustomerName || '-' %></td>
          <td><%= f.LeadName || '-' %></td>
          <td><span class="badge bg-<%= {Planned:'primary',Completed:'success',Missed:'danger',Cancelled:'secondary'}[f.Status]||'secondary' %>"><%= f.Status %></span></td>
          <td><%= f.AssignedName || '-' %></td>
          <td>
            <a href="/followups/edit/<%= f.FollowUpId %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
            <form method="POST" action="/followups/delete/<%= f.FollowUpId %>" class="d-inline"
              onsubmit="return confirm('Delete this follow-up?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
